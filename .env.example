# Copy to .env.local. Every value is optional: without them the site runs and every
# integration-dependent feature shows an explicit "integration pending" state.

# Endpoint that receives form submissions as JSON (CRM / Payload / serverless function).
# Without it, forms validate but DO NOT send, and say so to the visitor.
NEXT_PUBLIC_FORMS_ENDPOINT=

# Base URL of the Partner Access API (auth, partner catalog, requests).
# Without it, login/register/recover show "authentication service not connected".
NEXT_PUBLIC_PARTNER_API_URL=

# Public site URL used for canonical links and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://fenixfragrancesholding.uk

# GA4 measurement ID — only loaded after cookie consent (consent banner pending legal text).
NEXT_PUBLIC_GA4_ID=
